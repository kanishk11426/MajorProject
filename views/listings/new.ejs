<% layout("layouts/boilerplate") %>
<div class="form-shell">
    <div class="form-card">
        <header class="form-header">
            <p class="eyebrow">Host your space</p>
            <h1>Create a new listing</h1>
            <p>Share the kind of place guests will love.</p>
        </header>

        <form action="/listings" method="POST" novalidate class="needs-validation">
            <div class="form-grid">
                <div class="field full">
                    <label for="title">Title</label>
                    <input
                        type="text"
                        name="listing[title]"
                        id="title"
                        placeholder="Oceanfront villa with sunset view"
                        required
                    />
                    <div class="invalid-feedback">Please enter a title.</div>
                    <div class="valid-feedback">Title looks good!</div>
                </div>

                <div class="field full">
                    <label for="description">Description</label>
                    <textarea 
                            name="listing[description]" 
                            id="description" 
                            placeholder="Describe the experience, atmosphere, and standout features..."
                            required>
                        </textarea>
                    <div class="invalid-feedback">Please enter a description.</div>
                </div>

                <div class="field full">
                    <label for="image">Image URL</label>
                    <input
                        type="text"
                        name="listing[image]"
                        id="image"
                        placeholder="https://example.com/your-home.jpg"
                    />
                </div>

                <div class="field">
                    <label for="price">Price</label>
                    <input
                        name="listing[price]"
                        id="price"
                        type="number"
                        min="1"
                        required
                    />
                    <div class="invalid-feedback">Please enter a price greater than 0.</div>
                </div>

                <div class="field">
                    <label for="location">Location</label>
                    <input
                        type="text"
                        name="listing[location]"
                        id="location"
                        required
                    />
                    <div class="invalid-feedback">Please enter a location.</div>
                </div>

                <div class="field full">
                    <label for="country">Country</label>
                    <input
                        type="text"
                        name="listing[country]"
                        id="country"
                        required
                    />
                    <div class="invalid-feedback">Please enter a country.</div>
                </div>
            </div>

            <div class="form-actions">
                <a class="secondary-btn" href="/listings">Cancel</a>
                <button class="submit-btn" type="submit">Publish listing</button>
            </div>
        </form>
    </div>
</div>
 
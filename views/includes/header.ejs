<header class="navbar">
  <div class="nav-inner">
    <a class="brand" href="/listings" aria-label="Wanderlust home">Wanderlust</a>

    <nav class="nav-actions" aria-label="Main navigation">
      <a class="host-link" href="/listings">Explore stays</a>
      <a class="host-link" href="/listings/new">List your place</a>
      <br> <br>
      <div class="ms-auto">
        <% if (!currUser) { %>
          <a class="host-link" href="/signup">Sign up</a>
          <a class="host-link" href="/login">Login</a>
        <% } %>

        <% if (currUser) { %>
          <span class="user-welcome">👋 Welcome, <strong><%= currUser.username.charAt(0).toUpperCase() + currUser.username.slice(1) %>.</strong></span>
          <a class="host-link" href="/logout">Log out</a>
        <% } %>

      </div>
    </nav>

  </div>
</header>